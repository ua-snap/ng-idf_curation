# Site paths. Plain KEY=VALUE (no shell expansion). Environment variables of the same name override.
DATA_ROOT=/import/beegfs/SNAP/jdpaul3/ng-idf_curation_data
# Read-only source data
RAW_FORCING_ROOT=/import/beegfs/CMIP6/arctic-cmip6/NG-IDL-Full-Forcing/whole_AK_forcing
AUTHOR_FORCING_ROOT=/import/beegfs/CMIP6/arctic-cmip6/NG-IDL
# Default Slurm placement
SLURM_PARTITION=t2small
SLURM_QOS=tier2
# Source inputs (relative to DATA_ROOT, or to RAW_FORCING_ROOT for the grid files)
PLACES_SNAPSHOT=raw/earthmaps_places/communities_20261117.json
DAYMET_LAND_CACHE=work/daymet_land_cache.json
NLCD_RASTER=raw/nlcd_2016_ak/NLCD_2016_Land_Cover_AK_20200724.img
EVH_RASTER=raw/landfire_evh_2016_ak/LF2016_EVH_AK/Tif/LF2016_EVH_AK.tif
GLASS_DIR=raw/glass_lai_2016_500m
WRF_GRID_FILE=WRF/historical/hsf/NNA.4km.hERA5.1989.003.wrf.hsf.1989-06-01.nc
CESM_GRID_FILE=CESM2-LE/cesm2le/hC2LE2/hsf/NNA.4km.hC2LE2.1989.006.wrf.hsf.1989-06-01.nc
