# NG-IDF app version used for a release. Plain KEY=VALUE (no shell expansion): read by bash and Python.
# To add a version: mirror the upstream commit into ua-snap/NG_IDF as tag app-<sha7>, copy this file
# to <sha7>.env, update the values, and run the pipeline with MODEL_VERSION=<sha7>.
MODEL_LABEL=a582a5c
MODEL_DESCRIPTION=H. Yan NG-IDF app, branch feature/add_spatial_map (2026-10-30); DHSVM 3.2 without soil temperature
UPSTREAM_REPO=https://github.com/hydro-yan/NG_IDF_AWS.git
UPSTREAM_BRANCH=feature/add_spatial_map
APP_REPO=https://github.com/ua-snap/NG_IDF.git
APP_REF=app-a582a5c
APP_COMMIT=a582a5cf22e2142740e2839abf3f89213c27dc56
# Previous model version whose release the QA compares against (empty for the first one).
BASELINE_MODEL=
# Or, without a baseline model version: a coverage directory (relative to DATA_ROOT) to compare with.
# Here: the production made before the pipeline existed (2026-11-17), so the first pipeline release
# doubles as a regression test.
BASELINE_COVERAGE_DIR=output/coverage_v1
